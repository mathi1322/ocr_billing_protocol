# Copy to .env and fill in real values. .env is git-ignored.

# --- Supabase (Dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection for Alembic migrations
# (Dashboard -> Project Settings -> Database)
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<DB_PASSWORD>@<pooler-host>:5432/postgres

# --- AI providers ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- Extraction / validation tuning ---
EXTRACTION_ACCEPT_THRESHOLD=0.85
EXTRACTION_FALLBACK_THRESHOLD=0.5
EXTRACTION_MAX_PAGES=20

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
STORAGE_BUCKET=bills
